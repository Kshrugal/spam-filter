{
  "manifest_version": 3,
  "name": "Spam Detector",
  "version": "1.0",
  "description": "Checks if a message is spam using your Flask API",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
